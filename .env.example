# Copiá este archivo como .env.local y completá los valores

# ─── Contacto ───────────────────────────────────────────
NEXT_PUBLIC_WA_NUMBER=           # Número WhatsApp sin + (ej: 5491123989560)
NEXT_PUBLIC_TELEFONO=            # Texto visible (ej: 11 2398-9560)
NEXT_PUBLIC_EMAIL=               # Email de contacto
NEXT_PUBLIC_INSTAGRAM=           # URL completa de Instagram
NEXT_PUBLIC_FACEBOOK=            # URL completa de Facebook

# ─── Servicios externos ─────────────────────────────────
NEXT_PUBLIC_FORMSPREE=           # Endpoint de Formspree para postulaciones

# ─── SEO / Site ─────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DESC=
